# key.properties.example
# Copy this file to `key.properties` in this directory (or project root as defined in build.gradle.kts)
# and fill in your release keystore details for Google Play Store upload.
# NEVER commit your actual `key.properties` or `.jks/.keystore` file to Git!

storePassword=your_keystore_password
keyPassword=your_key_password
keyAlias=your_key_alias
storeFile=../upload-keystore.jks
