# ============================================================================
# Jugaad Backend — Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit the '.env' file containing secrets to version control!
# ============================================================================

# ─── System / Server Settings ───────────────────────────────────────────────
ENV=local
DEBUG=true
PORT=8000
HOST=0.0.0.0

# ─── Supabase Cloud (Hosted Database) ───────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
# Key bypassing Row Level Security (RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Standard Anon public key
SUPABASE_KEY=your-supabase-anon-key

# ─── Redis Cache & Queue (Local Docker Container) ───────────────────────────
# Inside Docker, use "redis" (the name of the container service).
# Outside Docker (local dev on host machine), use "localhost".
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ─── Firebase Authentication & Push Notifications ──────────────────────────
# Path to your Firebase service account JSON key file inside the container
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-credentials.json

# If deployment platform doesn't support file volumes, set the raw JSON content here:
FIREBASE_CREDENTIALS_JSON=

# ─── Payments: Razorpay ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ─── SMS Provider: MSG91 ────────────────────────────────────────────────────
SMS_MODE=fake
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-template-id
MSG91_SENDER_ID=JUGAAD

# ─── Other Modes ────────────────────────────────────────────────────────────
QUEUE_MODE=local
JWT_SECRET=your-jwt-signing-secret
CORS_ORIGINS=["http://localhost:3000","http://10.0.2.2:8000","http://127.0.0.1:8000"]
